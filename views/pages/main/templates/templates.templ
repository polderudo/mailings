package templatesview

import (
	"app/api/router"
	. "app/i18n"
	"app/mq"
	. "app/views/layout"

	uibutton "github.com/nakami-lounge-GmbH/ui-components/button"
	"github.com/nakami-lounge-GmbH/ui-components/datatable"
	breadcrumb "github.com/templui/templui/components/breadcrumb"
)

templ Templates(user *mq.UserProfile, lang string, rows []*mq.MailTemplate, state datatable.TableState) {
	@UserLayout(user, lang, Trl(ctx, L.Templates.AllTemplates)) {
		@TemplatesPage(lang, rows, state)
	}
}

templ TemplatesPage(lang string, rows []*mq.MailTemplate, state datatable.TableState) {
	<div class="space-y-4">
		@TemplatesBreadcrumbs(lang)
		<div class="flex justify-end">
			@uibutton.Button(uibutton.Props{
				Color: "primary",
				Size:  "sm",
				Label: Trl(ctx, L.Templates.NewTemplate),
				Attrs: templ.Attributes{
					"hx-get":      router.Reverse(router.Templates.New),
					"hx-push-url": "true",
				},
			})
		</div>
		<div>
			@TemplatesTable(rows, state)
		</div>
	</div>
}

templ TemplatesBreadcrumbs(lang string) {
	@breadcrumb.Breadcrumb() {
		@breadcrumb.List(breadcrumb.ListProps{Class: "text-xs"}) {
			@breadcrumb.Item() {
				@breadcrumb.Link(breadcrumb.LinkProps{Href: "/"}) {
					{ Trl(ctx, L.Navigation.Home) }
				}
			}
			@breadcrumb.Item() {
				@breadcrumb.Separator()
				{ Trl(ctx, L.Mailings.Mailings) }
			}
			@breadcrumb.Item() {
				@breadcrumb.Separator()
				@breadcrumb.Page(breadcrumb.ItemProps{Class: "font-bold"}) {
					{ Trl(ctx, L.Templates.AllTemplates) }
				}
			}
		}
	}
}
