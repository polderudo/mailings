package templatesview

import (
	"app/api/router"
	"app/mq"
	. "app/i18n"
	"context"
	"strconv"

	"github.com/nakami-lounge-GmbH/ui-components/datatable"
	"github.com/templui/templui/components/table"
)

// templateUpdatedDisplay formattiert den effektiven Update-Zeitstempel.
// Fällt auf created_at zurück, wenn updated_at nie gesetzt wurde.
func templateUpdatedDisplay(t *mq.MailTemplate) string {
	ts := t.CreatedAt
	if ua, ok := t.UpdatedAt.Get(); ok {
		ts = ua
	}
	return ts.Format("2006-01-02 15:04")
}

func templatesCols(ctx context.Context, archived string) []datatable.ColumnDef {
	return []datatable.ColumnDef{
		{Field: "name", Label: Trl(ctx, L.Templates.TemplateName), Sortable: true, Filterable: true},
		{Field: "subject", Label: Trl(ctx, L.Templates.MailSubject), Sortable: true, Filterable: true},
		{Field: "updated_at", Label: Trl(ctx, L.Users.CreatedAt), Sortable: true, Class: "w-48"},
		{Field: "archived", Label: Trl(ctx, L.Ui.Archived), Filterable: true, Class: "w-36", FilterComponent: archivedFilter(ctx, archived)},
	}
}

templ TemplatesTable(rows []*mq.MailTemplate, state datatable.TableState) {
	@datatable.Table(templatesCols(ctx, state.Filters["archived"]), state) {
		for _, t := range rows {
			@templatesRow(t)
		}
	}
}

templ templatesRow(t *mq.MailTemplate) {
	{{ idStr := strconv.Itoa(int(t.ID)) }}
	@table.Row(table.RowProps{
		Attributes: templ.Attributes{
			"hx-get":      router.Reverse(router.Templates.Detail, idStr),
			"hx-push-url": "true",
			"class":       "cursor-pointer",
			"data-row-id": idStr,
		},
	}) {
		@table.Cell(table.CellProps{Class: "font-medium"}) {
			{ t.Name }
		}
		@table.Cell() {
			{ t.Subject }
		}
		@table.Cell() {
			{ templateUpdatedDisplay(t) }
		}
		@table.Cell() {
			if t.Archived {
				<span class="inline-flex items-center rounded bg-muted px-2 py-0.5 text-xs text-muted-foreground">{ Trl(ctx, L.Ui.Archived) }</span>
			}
		}
	}
}

// archivedFilter rendert das Tri-State-<select> für den Archiv-Filter.
// Leerer Wert == "active" (Default: nur nicht-archivierte anzeigen).
templ archivedFilter(ctx context.Context, current string) {
	<select name="archived" class="dt-filter h-7 w-full rounded-md border border-input bg-transparent px-2 text-sm">
		<option value="active" selected?={ current == "" || current == "active" }>{ Trl(ctx, L.Users.Active) }</option>
		<option value="archived" selected?={ current == "archived" }>{ Trl(ctx, L.Ui.Archived) }</option>
		<option value="all" selected?={ current == "all" }>{ Trl(ctx, L.General.All) }</option>
	</select>
}
