package usersview

import (
	"app/api/router"
	. "app/i18n"
	"app/mq"
	"context"
	"strconv"
	"strings"

	"github.com/nakami-lounge-GmbH/ui-components/datatable"
	"github.com/templui/templui/components/table"
)

func usersCols(ctx context.Context) []datatable.ColumnDef {
	return []datatable.ColumnDef{
		{Field: "full_name", Label: Trl(ctx, L.Users.User), Sortable: false, Filterable: true},
		{Field: "status", Label: Trl(ctx, LK_status), Sortable: false, Filterable: true, Class: "w-32"},
	}
}

templ UsersTable(rows []*mq.UserProfile, state datatable.TableState) {
	@datatable.Table(usersCols(ctx), state) {
		for _, u := range rows {
			@usersRow(u)
		}
	}
}

templ usersRow(u *mq.UserProfile) {
	{{ idStr := strconv.Itoa(int(u.ID)) }}
	{{
		fullName := strings.TrimSpace(strings.Join([]string{u.Forename, u.Lastname}, " "))
		if fullName == "" {
			fullName = u.Email
		}
		status := "active"
		if u.Disabled {
			status = "disabled"
		}
	}}
	@table.Row(table.RowProps{
		Attributes: templ.Attributes{
			"hx-get":      router.Reverse(router.Users.Detail, idStr),
			"hx-push-url": "true",
			"class":       "cursor-pointer",
			"data-row-id": idStr,
		},
	}) {
		@table.Cell() {
			<div class="flex flex-col">
				<span class="font-medium">{ fullName }</span>
				<span class="text-xs text-muted-foreground">{ u.Email }</span>
			</div>
		}
		@table.Cell() {
			{ status }
		}
	}
}
