package usersview

import (
	"app/api/router"
	appdb "app/db"
	. "app/i18n"
	globaltable "github.com/nakami-lounge-GmbH/ui-components/table"
)

const CurrentUsersTableID = "users-table"

func normalizeUsersTableRequest(request globaltable.Request) globaltable.Request {
	if request.FilterCriteria == nil {
		request.FilterCriteria = map[string]string{}
	}
	if request.Pagination.Page < 1 {
		request.Pagination.Page = 1
	}
	if request.Pagination.Count <= 0 {
		request.Pagination.Count = 50
	}
	if len(request.Pagination.Sorts) == 0 {
		request.Pagination.Sorts = []globaltable.SortParam{{
			Field:  "fullName",
			IsDesc: false,
		}}
	}
	return request
}

func CurrentUsersTableProps(lang string, rows []appdb.UserProfileTableRow, request globaltable.Request, total int64) globaltable.TableProps {
	return globaltable.TableProps{
		Lang:                NormalizeLang(lang),
		ID:                  CurrentUsersTableID,
		Class:               "mt-6",
		Endpoint:            router.Reverse(router.Users.List),
		Request:             normalizeUsersTableRequest(request),
		Total:               total,
		Title:               TrLang(lang, L.Users.AllUsers),
		Description:         TrLang(lang, L.Users.ListOfAllRegisteredUsers),
		RowClickAccessorKey: "id",
		RowClickURLPattern:  router.Reverse(router.Users.Detail, "{value}"),
		PageSizes: []int{
			10,
			25,
			50,
			100,
		},
		Columns: []globaltable.Column{
			{
				AccessorKey: "id",
				Header:      TrLang(lang, L.Users.Id),
				Kind:        "id",
				Width:       "5rem",
				MinWidth:    "5rem",
				Sortable:    true,
			},
			{
				AccessorKey: "fullName",
				Header:      TrLang(lang, L.Users.User),
				MinWidth:    "18rem",
				Sortable:    true,
				Display: globaltable.ColumnDisplay{
					Variant:             "stacked",
					SubtitleAccessorKey: "email",
				},
			},
			{
				AccessorKey: "accountStatus",
				Header:      TrLang(lang, LK_status),
				Kind:        "status",
				Width:       "9rem",
				MinWidth:    "9rem",
				Sortable:    true,
			},
		},
		Data:         rows,
		EmptyMessage: TrLang(lang, L.Users.NoUsersFound),
	}
}

templ CurrentUsersTable(lang string, rows []appdb.UserProfileTableRow, request globaltable.Request, total int64) {
	@globaltable.Table(CurrentUsersTableProps(lang, rows, request, total))
}
