package usersview

import (
	"app/api/router"
	. "app/i18n"
	tuicard "github.com/templui/templui/components/card"
)

templ UsersFilterPanel(lang string, filters UsersFilterData) {
	@tuicard.Card() {
		@tuicard.Content() {
			<form
				class="grid gap-3 sm:grid-cols-2 md:grid-cols-3"
				hx-get={ router.Reverse(router.Users.List) }
				hx-target="#users-table"
				hx-trigger="change">
				<div class="flex flex-col gap-1">
					<label for="filter_status" class="text-xs text-muted-foreground">
						{ Trl(ctx, L.Labels.Status) }
					</label>
					<select id="filter_status" name="filter_status" class="rounded border px-2 py-1.5">
						<option value="">{ Trl(ctx, L.General.All) }</option>
						<option value="active" selected?={ filters.SelectedStatus == "active" }>{ Trl(ctx, L.Users.Active) }</option>
						<option value="disabled" selected?={ filters.SelectedStatus == "disabled" }>{ Trl(ctx, L.Users.Disabled) }</option>
					</select>
				</div>
			</form>
		}
	}
}
