package blacklistview

import (
	"app/api/router"
	. "app/i18n"
	"app/mq"
	. "app/views/layout"

	uibutton "github.com/nakami-lounge-GmbH/ui-components/button"
	"github.com/nakami-lounge-GmbH/ui-components/datatable"
	breadcrumb "github.com/templui/templui/components/breadcrumb"
)

templ Blacklist(user *mq.UserProfile, lang string, rows []*mq.MailBlacklist, state datatable.TableState) {
	@UserLayout(user, lang, Trl(ctx, L.Blacklist.Blacklist)) {
		@BlacklistPage(lang, rows, state)
	}
}

templ BlacklistPage(lang string, rows []*mq.MailBlacklist, state datatable.TableState) {
	<div class="space-y-4">
		@BlacklistBreadcrumbs(lang)
		<div class="flex justify-end">
			@uibutton.Button(uibutton.Props{
				Color: "primary",
				Size:  "sm",
				Label: Trl(ctx, L.Blacklist.SynchronizeNow),
				Attrs: templ.Attributes{
					"hx-post":   router.Reverse(router.Blacklist.Sync),
					"hx-target": "#layout-content-body",
				},
			})
		</div>
		<div>
			@BlacklistTable(rows, state)
		</div>
	</div>
}

templ BlacklistBreadcrumbs(lang string) {
	@breadcrumb.Breadcrumb() {
		@breadcrumb.List(breadcrumb.ListProps{Class: "text-xs"}) {
			@breadcrumb.Item() {
				@breadcrumb.Link(breadcrumb.LinkProps{Href: "/"}) {
					{ Trl(ctx, L.Navigation.Home) }
				}
			}
			@breadcrumb.Item() {
				@breadcrumb.Separator()
				{ Trl(ctx, L.Mailings.Mailings) }
			}
			@breadcrumb.Item() {
				@breadcrumb.Separator()
				@breadcrumb.Page(breadcrumb.ItemProps{Class: "font-bold"}) {
					{ Trl(ctx, L.Blacklist.Blacklist) }
				}
			}
		}
	}
}
