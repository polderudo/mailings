package mailingsview

import (
	"app/api/router"
	"app/db"
	. "app/i18n"
	"app/mq"
	. "app/views/layout"
	uibutton "github.com/nakami-lounge-GmbH/ui-components/button"
	globaltable "github.com/nakami-lounge-GmbH/ui-components/table"
	breadcrumb "github.com/templui/templui/components/breadcrumb"
)

templ Mailings(user *mq.UserProfile, lang string, rows []db.MailingTableRow, request globaltable.Request, total int64) {
	@UserLayout(user, lang, Trl(ctx, L.Mailings.AllMailings)) {
		@MailingsListPage(lang, rows, request, total)
	}
}

templ MailingsListPage(lang string, rows []db.MailingTableRow, request globaltable.Request, total int64) {
	<div class="space-y-4">
		@MailingsBreadcrumbs(lang)
		<div class="flex justify-end">
			@uibutton.Button(uibutton.Props{
				Color: "primary",
				Size:  "sm",
				Label: Trl(ctx, L.Mailings.NewMailing),
				Attrs: templ.Attributes{
					"hx-get":      router.Reverse(router.Mailings.New),
					"hx-push-url": "true",
				},
			})
		</div>
		<div>
			@CurrentMailingsTable(lang, rows, request, total)
		</div>
	</div>
}

templ MailingsBreadcrumbs(lang string) {
	@breadcrumb.Breadcrumb() {
		@breadcrumb.List(breadcrumb.ListProps{Class: "text-xs"}) {
			@breadcrumb.Item() {
				@breadcrumb.Link(breadcrumb.LinkProps{Href: "/"}) {
					{ Trl(ctx, L.Navigation.Home) }
				}
			}
			@breadcrumb.Item() {
				@breadcrumb.Separator()
				@breadcrumb.Page(breadcrumb.ItemProps{Class: "font-bold"}) {
					{ Trl(ctx, L.Mailings.AllMailings) }
				}
			}
		}
	}
}
