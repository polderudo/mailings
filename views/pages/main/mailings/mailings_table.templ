package mailingsview

import (
	"app/api/router"
	"app/db"
	. "app/i18n"
	"context"
	"strconv"

	"github.com/nakami-lounge-GmbH/ui-components/datatable"
	"github.com/templui/templui/components/table"
)

func mailingsCols(ctx context.Context) []datatable.ColumnDef {
	return []datatable.ColumnDef{
		{Field: "name", Label: Trl(ctx, L.Mailings.MailingName), Sortable: true, Filterable: true},
		{Field: "template_name", Label: Trl(ctx, L.Mailings.Template)},
		{Field: "list_name", Label: Trl(ctx, L.Mailings.EmailList)},
		{Field: "domain_name", Label: Trl(ctx, L.Mailings.Sender)},
		{Field: "status", Label: Trl(ctx, L.Mailings.MailingStatus), Sortable: true, Filterable: true, Class: "w-32"},
		{Field: "recipient_count", Label: Trl(ctx, L.Mailings.TotalRecipients), Class: "w-24"},
		{Field: "postmark_percentage_completed", Label: Trl(ctx, L.Mailings.Progress), Sortable: true, Class: "w-24"},
	}
}

templ MailingsTable(rows []db.MailingWithMeta, state datatable.TableState) {
	@datatable.Table(mailingsCols(ctx), state) {
		for _, m := range rows {
			@mailingsRow(m)
		}
	}
}

templ mailingsRow(m db.MailingWithMeta) {
	{{ idStr := strconv.Itoa(int(m.ID)) }}
	@table.Row(table.RowProps{
		Attributes: templ.Attributes{
			"hx-get":      router.Reverse(router.Mailings.Detail, idStr),
			"hx-push-url": "true",
			"class":       "cursor-pointer",
			"data-row-id": idStr,
		},
	}) {
		@table.Cell(table.CellProps{Class: "font-medium"}) {
			{ m.Name }
		}
		@table.Cell() { { m.TemplateName } }
		@table.Cell() { { m.ListName } }
		@table.Cell() { { m.DomainName } }
		@table.Cell() { { m.Status } }
		@table.Cell() { { strconv.FormatInt(m.RecipientCount, 10) } }
		@table.Cell() { { strconv.FormatFloat(m.PostmarkPercentageCompleted, 'f', 0, 64) }% }
	}
}
