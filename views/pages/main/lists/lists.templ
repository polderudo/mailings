package listsview

import (
	"app/api/router"
	"app/db"
	. "app/i18n"
	"app/mq"
	. "app/views/layout"

	uibutton "github.com/nakami-lounge-GmbH/ui-components/button"
	"github.com/nakami-lounge-GmbH/ui-components/datatable"
	breadcrumb "github.com/templui/templui/components/breadcrumb"
)

templ Lists(user *mq.UserProfile, lang string, rows []db.MailListWithCount, state datatable.TableState) {
	@UserLayout(user, lang, Trl(ctx, L.Lists.AllEmailLists)) {
		@ListsPage(lang, rows, state)
	}
}

templ ListsPage(lang string, rows []db.MailListWithCount, state datatable.TableState) {
	<div class="space-y-4">
		@ListsBreadcrumbs(lang)
		<div class="flex justify-end">
			@uibutton.Button(uibutton.Props{
				Color: "primary",
				Size:  "sm",
				Label: Trl(ctx, L.Lists.NewEmailList),
				Attrs: templ.Attributes{
					"hx-get":      router.Reverse(router.Lists.New),
					"hx-push-url": "true",
				},
			})
		</div>
		<div>
			@ListsTable(rows, state)
		</div>
	</div>
}

templ ListsBreadcrumbs(lang string) {
	@breadcrumb.Breadcrumb() {
		@breadcrumb.List(breadcrumb.ListProps{Class: "text-xs"}) {
			@breadcrumb.Item() {
				@breadcrumb.Link(breadcrumb.LinkProps{Href: "/"}) {
					{ Trl(ctx, L.Navigation.Home) }
				}
			}
			@breadcrumb.Item() {
				@breadcrumb.Separator()
				{ Trl(ctx, L.Mailings.Mailings) }
			}
			@breadcrumb.Item() {
				@breadcrumb.Separator()
				@breadcrumb.Page(breadcrumb.ItemProps{Class: "font-bold"}) {
					{ Trl(ctx, L.Lists.AllEmailLists) }
				}
			}
		}
	}
}
