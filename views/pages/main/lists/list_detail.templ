package listsview

import (
	"app/api/router"
	. "app/i18n"
	"app/mq"
	. "app/views/layout"
	"context"
	"strconv"

	uibutton "github.com/nakami-lounge-GmbH/ui-components/button"
	"github.com/nakami-lounge-GmbH/ui-components/datatable"
	uidropzone "github.com/nakami-lounge-GmbH/ui-components/dropzone"
	uiform "github.com/nakami-lounge-GmbH/ui-components/form"
	uiinput "github.com/nakami-lounge-GmbH/ui-components/input"
	breadcrumb "github.com/templui/templui/components/breadcrumb"
	tuicard "github.com/templui/templui/components/card"
	tuidialog "github.com/templui/templui/components/dialog"
)

// ListFormData transportiert sowohl die Form-Header-Daten der Liste als auch
// den paginated state der Recipients-Tabelle. RecipientsRows/RecipientsState
// werden nur gefüllt, wenn IsNew == false.
type ListFormData struct {
	ID              int32
	Name            string
	Description     string
	Archived        bool
	IsNew           bool
	RecipientsRows  []*mq.MailListRecipient
	RecipientsState datatable.TableState
}

templ ListDetail(user *mq.UserProfile, lang string, data ListFormData) {
	@UserLayout(user, lang, Trl(ctx, L.Lists.EmailListDetail)) {
		@ListDetailPage(lang, data)
	}
}

templ ListDetailPage(lang string, data ListFormData) {
	<div class="space-y-4">
		@ListDetailBreadcrumbs(lang, data)
		@ListForm(lang, data)
		if !data.IsNew {
			@ListImportPanel(lang, data)
			@ListRecipientsPanel(lang, data.ID, data.RecipientsRows, data.RecipientsState)
		}
	</div>
}

templ ListDetailBreadcrumbs(lang string, data ListFormData) {
	@breadcrumb.Breadcrumb() {
		@breadcrumb.List(breadcrumb.ListProps{Class: "text-xs"}) {
			@breadcrumb.Item() {
				@breadcrumb.Link(breadcrumb.LinkProps{Href: "/"}) {
					{ Trl(ctx, L.Navigation.Home) }
				}
			}
			@breadcrumb.Item() {
				@breadcrumb.Separator()
				@breadcrumb.Link(breadcrumb.LinkProps{Href: router.Reverse(router.Lists.List)}) {
					{ Trl(ctx, L.Lists.AllEmailLists) }
				}
			}
			@breadcrumb.Item() {
				@breadcrumb.Separator()
				@breadcrumb.Page(breadcrumb.ItemProps{Class: "font-bold"}) {
					if data.IsNew {
						{ Trl(ctx, L.Lists.NewEmailList) }
					} else {
						{ data.Name }
					}
				}
			}
		}
	}
}

templ ListForm(lang string, data ListFormData) {
	{{
		formAction := router.Reverse(router.Lists.Create)
		if !data.IsNew {
			formAction = router.Reverse(router.Lists.Update, strconv.Itoa(int(data.ID)))
		}
	}}
	@tuicard.Card() {
		@tuicard.Header() {
			@tuicard.Title(tuicard.TitleProps{Class: "text-base"}) {
				if data.IsNew {
					{ Trl(ctx, L.Lists.NewEmailList) }
				} else {
					{ Trl(ctx, L.Lists.EmailListDetail) }
				}
			}
		}
		@tuicard.Content() {
			@uiform.Form(uiform.FormProps{
				Class:  "flex flex-col gap-4",
				Action: formAction,
				Method: "post",
				Attributes: templ.Attributes{
					"hx-post":   formAction,
					"hx-swap":   "outerHTML",
					"hx-target": "this",
				},
			}) {
				@uiform.Item() {
					@uiform.Label(uiform.LabelProps{For: "name"}) {
						{ Trl(ctx, L.Lists.ListName) }
					}
					@uiinput.Input(uiinput.Props{
						ID:       "name",
						Name:     "name",
						Value:    data.Name,
						Required: true,
					})
				}
				@uiform.Item() {
					@uiform.Label(uiform.LabelProps{For: "description"}) {
						{ Trl(ctx, L.Lists.ListDescription) }
					}
					<textarea
						id="description"
						name="description"
						rows="2"
						class="w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px]">
						{ data.Description }
					</textarea>
				}
				<div class="flex justify-end gap-2">
					if !data.IsNew {
						@uibutton.Button(uibutton.Props{
							Color: "secondary",
							Size:  "sm",
							Label: archiveLabel(ctx, data.Archived),
							Attrs: templ.Attributes{
								"type":    "button",
								"hx-post": router.Reverse(router.Lists.Archive, strconv.Itoa(int(data.ID))),
							},
						})
					}
					@uibutton.Button(uibutton.Props{
						Type:  "submit",
						Color: "primary",
						Size:  "sm",
						Label: Trl(ctx, L.Lists.SaveList),
					})
				</div>
			}
		}
	}
}

templ ListImportPanel(lang string, data ListFormData) {
	@tuicard.Card() {
		@tuicard.Header() {
			@tuicard.Title(tuicard.TitleProps{Class: "text-base"}) {
				{ Trl(ctx, L.Lists.ImportRecipients) }
			}
		}
		@tuicard.Content() {
			{{ importAction := router.Reverse(router.Lists.Import, strconv.Itoa(int(data.ID))) }}
			@uiform.Form(uiform.FormProps{
				Class:  "flex flex-col gap-3",
				Action: importAction,
				Method: "post",
				Attributes: templ.Attributes{
					"hx-post":     importAction,
					"hx-swap":     "outerHTML",
					"hx-target":   "#list-recipients-panel",
					"hx-encoding": "multipart/form-data",
					"enctype":     "multipart/form-data",
				},
			}) {
				@uidropzone.Dropzone(uidropzone.Props{
					Name:              "file",
					AllowedExtensions: []string{"xlsx"},
					MaxSizeBytes:      10 * 1024 * 1024,
					Description:       Trl(ctx, L.Lists.ExcelHeaderColumnsEmailVornameNachname),
					Required:          true,
				})
				<div class="flex justify-end">
					@uibutton.Button(uibutton.Props{
						Type:  "submit",
						Color: "primary",
						Size:  "sm",
						Label: Trl(ctx, L.Lists.AddRecipients),
					})
				</div>
			}
		}
	}
}

// ListRecipientsPanel wraps Header + paginierte Tabelle + Confirm-Dialog.
// Wird komplett re-gerendert nach Import / Delete. Die innere Tabelle wird
// für sort/filter/page-Updates separat als ListRecipientsTable getauscht
// (Target = #list-recipients-table-container).
templ ListRecipientsPanel(lang string, listID int32, rows []*mq.MailListRecipient, state datatable.TableState) {
	{{ deleteURLPattern := router.Reverse(router.Lists.DeleteRecipient, strconv.Itoa(int(listID)), "__REC__") }}
	<div
		id="list-recipients-panel"
		x-data={ "{ pendingRecId: 0, pendingRecEmail: '', deleteURLPattern: " + alpineString(deleteURLPattern) + " }" }
	>
		@tuicard.Card() {
			@tuicard.Header() {
				@tuicard.Title(tuicard.TitleProps{Class: "text-base"}) {
					{ Trl(ctx, L.Lists.Recipients) } ({ strconv.FormatInt(state.Total, 10) })
				}
			}
			@tuicard.Content() {
				@addRecipientForm(lang, listID)
				<div id="list-recipients-table-container">
					@ListRecipientsTable(rows, state)
				</div>
			}
		}
		@confirmDeleteRecipientDialog(lang)
	</div>
}

// addRecipientForm ist das Inline-Formular zum direkten Hinzufügen eines
// einzelnen Empfängers. POST → ListRecipientAdd, re-rendert das ganze
// #list-recipients-panel. Nach erfolgreichem Request wird das Formular geleert.
templ addRecipientForm(lang string, listID int32) {
	{{ addAction := router.Reverse(router.Lists.AddRecipient, strconv.Itoa(int(listID))) }}
	@uiform.Form(uiform.FormProps{
		Class:  "mb-4 flex flex-col gap-3 sm:flex-row sm:items-end",
		Action: addAction,
		Method: "post",
		Attributes: templ.Attributes{
			"hx-post":              addAction,
			"hx-swap":              "outerHTML",
			"hx-target":            "#list-recipients-panel",
			"hx-on::after-request": "if(event.detail.successful){this.reset()}",
		},
	}) {
		<div class="flex-1">
			@uiform.Label(uiform.LabelProps{For: "add-email"}) {
				{ Trl(ctx, L.Auth.Email) }
			}
			@uiinput.Input(uiinput.Props{
				ID:       "add-email",
				Name:     "email",
				Required: true,
			})
		</div>
		<div class="flex-1">
			@uiform.Label(uiform.LabelProps{For: "add-forename"}) {
				{ Trl(ctx, L.Auth.FirstName) }
			}
			@uiinput.Input(uiinput.Props{ID: "add-forename", Name: "forename"})
		</div>
		<div class="flex-1">
			@uiform.Label(uiform.LabelProps{For: "add-lastname"}) {
				{ Trl(ctx, L.Auth.LastName) }
			}
			@uiinput.Input(uiinput.Props{ID: "add-lastname", Name: "lastname"})
		</div>
		@uibutton.Button(uibutton.Props{
			Type:  "submit",
			Color: "primary",
			Size:  "sm",
			Label: Trl(ctx, L.Lists.AddRecipient),
		})
	}
}

// archiveLabel liefert "Wiederherstellen" wenn archiviert, sonst "Archivieren".
func archiveLabel(ctx context.Context, archived bool) string {
	if archived {
		return Trl(ctx, L.Ui.Restore)
	}
	return Trl(ctx, L.Ui.Archive)
}

// alpineString quotes a Go string so it can be embedded inside a templ string
// attribute that itself ends up as an x-on:click expression. Single quotes are
// used as the JS string delimiter, single quotes inside the value are escaped.
func alpineString(s string) string {
	out := make([]byte, 0, len(s)+2)
	out = append(out, '\'')
	for i := 0; i < len(s); i++ {
		c := s[i]
		switch c {
		case '\\', '\'':
			out = append(out, '\\', c)
		default:
			out = append(out, c)
		}
	}
	out = append(out, '\'')
	return string(out)
}

templ confirmDeleteRecipientDialog(lang string) {
	@tuidialog.Dialog(tuidialog.Props{ID: "confirm-delete-recipient"}) {
		@tuidialog.Content() {
			@tuidialog.Header() {
				@tuidialog.Title() { { Trl(ctx, L.Lists.RemoveRecipient) } }
				@tuidialog.Description() {
					{ Trl(ctx, L.Lists.ThisWillPermanentlyRemoveTheRecipK5lat5y3) }
					<br/>
					<span class="font-medium" x-text="pendingRecEmail"></span>
				}
			}
			@tuidialog.Footer() {
				@tuidialog.Close() {
					@uibutton.Button(uibutton.Props{
						Color: "secondary",
						Size:  "sm",
						Label: Trl(ctx, L.Users.Cancel),
						Attrs: templ.Attributes{"type": "button"},
					})
				}
				@uibutton.Button(uibutton.Props{
					Color: "primary",
					Size:  "sm",
					Label: Trl(ctx, L.Lists.DeleteRecipient),
					Attrs: templ.Attributes{
						"type":   "button",
						"@click": "htmx.ajax('DELETE', deleteURLPattern.replace('__REC__', pendingRecId), {target: '#list-recipients-panel', swap: 'outerHTML'}); window.tui.dialog.close('confirm-delete-recipient');",
					},
				})
			}
		}
	}
}
