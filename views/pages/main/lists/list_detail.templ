package listsview

import (
	"app/api/router"
	. "app/i18n"
	"app/mq"
	. "app/views/layout"
	"strconv"
	uibutton "github.com/nakami-lounge-GmbH/ui-components/button"
	uiform "github.com/nakami-lounge-GmbH/ui-components/form"
	uiinput "github.com/nakami-lounge-GmbH/ui-components/input"
	breadcrumb "github.com/templui/templui/components/breadcrumb"
	tuicard "github.com/templui/templui/components/card"
)

type ListFormData struct {
	ID          int32
	Name        string
	Description string
	IsNew       bool
	Recipients  []*mq.MailListRecipient
}

templ ListDetail(user *mq.UserProfile, lang string, data ListFormData) {
	@UserLayout(user, lang, Trl(ctx, L.Lists.EmailListDetail)) {
		@ListDetailPage(lang, data)
	}
}

templ ListDetailPage(lang string, data ListFormData) {
	<div class="space-y-4">
		@ListDetailBreadcrumbs(lang, data)
		@ListForm(lang, data)
		if !data.IsNew {
			@ListImportPanel(lang, data)
			@ListRecipientsPanel(lang, data)
		}
	</div>
}

templ ListDetailBreadcrumbs(lang string, data ListFormData) {
	@breadcrumb.Breadcrumb() {
		@breadcrumb.List(breadcrumb.ListProps{Class: "text-xs"}) {
			@breadcrumb.Item() {
				@breadcrumb.Link(breadcrumb.LinkProps{Href: "/"}) {
					{ Trl(ctx, L.Navigation.Home) }
				}
			}
			@breadcrumb.Item() {
				@breadcrumb.Separator()
				@breadcrumb.Link(breadcrumb.LinkProps{Href: router.Reverse(router.Lists.List)}) {
					{ Trl(ctx, L.Lists.AllEmailLists) }
				}
			}
			@breadcrumb.Item() {
				@breadcrumb.Separator()
				@breadcrumb.Page(breadcrumb.ItemProps{Class: "font-bold"}) {
					if data.IsNew {
						{ Trl(ctx, L.Lists.NewEmailList) }
					} else {
						{ data.Name }
					}
				}
			}
		}
	}
}

templ ListForm(lang string, data ListFormData) {
	{{
		formAction := router.Reverse(router.Lists.Create)
		if !data.IsNew {
			formAction = router.Reverse(router.Lists.Update, strconv.Itoa(int(data.ID)))
		}
	}}
	@tuicard.Card() {
		@tuicard.Header() {
			@tuicard.Title(tuicard.TitleProps{Class: "text-base"}) {
				if data.IsNew {
					{ Trl(ctx, L.Lists.NewEmailList) }
				} else {
					{ Trl(ctx, L.Lists.EmailListDetail) }
				}
			}
		}
		@tuicard.Content() {
			@uiform.Form(uiform.FormProps{
				Class:  "flex flex-col gap-4",
				Action: formAction,
				Method: "post",
				Attributes: templ.Attributes{
					"hx-post":   formAction,
					"hx-swap":   "outerHTML",
					"hx-target": "this",
				},
			}) {
				@uiform.Item() {
					@uiform.Label(uiform.LabelProps{For: "name"}) {
						{ Trl(ctx, L.Lists.ListName) }
					}
					@uiinput.Input(uiinput.Props{
						ID:       "name",
						Name:     "name",
						Value:    data.Name,
						Required: true,
					})
				}
				@uiform.Item() {
					@uiform.Label(uiform.LabelProps{For: "description"}) {
						{ Trl(ctx, L.Lists.ListDescription) }
					}
					<textarea
						id="description"
						name="description"
						rows="2"
						class="w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px]">
						{ data.Description }
					</textarea>
				}
				<div class="flex justify-end">
					@uibutton.Button(uibutton.Props{
						Type:  "submit",
						Color: "primary",
						Size:  "sm",
						Label: Trl(ctx, L.Lists.SaveList),
					})
				</div>
			}
		}
	}
}

templ ListImportPanel(lang string, data ListFormData) {
	@tuicard.Card() {
		@tuicard.Header() {
			@tuicard.Title(tuicard.TitleProps{Class: "text-base"}) {
				{ Trl(ctx, L.Lists.ImportRecipients) }
			}
		}
		@tuicard.Content() {
			<p class="text-xs text-muted-foreground mb-2">
				{ Trl(ctx, L.Lists.OneEmailPerLineOptionallyFollowedQvz235ea) }
			</p>
			{{ importAction := router.Reverse(router.Lists.Import, strconv.Itoa(int(data.ID))) }}
			@uiform.Form(uiform.FormProps{
				Class:  "flex flex-col gap-3",
				Action: importAction,
				Method: "post",
				Attributes: templ.Attributes{
					"hx-post":   importAction,
					"hx-swap":   "outerHTML",
					"hx-target": "#list-recipients-panel",
				},
			}) {
				<textarea
					name="recipients"
					rows="8"
					placeholder={ Trl(ctx, L.Lists.PasteEmailAddressesOnePerLine) }
					class="w-full rounded-md border border-input bg-transparent px-3 py-2 font-mono text-sm shadow-xs outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px]"></textarea>
				<div class="flex justify-end">
					@uibutton.Button(uibutton.Props{
						Type:  "submit",
						Color: "primary",
						Size:  "sm",
						Label: Trl(ctx, L.Lists.AddRecipients),
					})
				</div>
			}
		}
	}
}

templ ListRecipientsPanel(lang string, data ListFormData) {
	<div id="list-recipients-panel">
		@tuicard.Card() {
			@tuicard.Header() {
				@tuicard.Title(tuicard.TitleProps{Class: "text-base"}) {
					{ Trl(ctx, L.Lists.Recipients) } ({ strconv.Itoa(len(data.Recipients)) })
				}
			}
			@tuicard.Content() {
				if len(data.Recipients) == 0 {
					<p class="text-sm text-muted-foreground">{ Trl(ctx, L.Lists.NoRecipientsYet) }</p>
				} else {
					<div class="overflow-x-auto">
						<table class="w-full text-sm">
							<thead>
								<tr class="text-left text-xs text-muted-foreground border-b">
									<th class="py-2 pr-3">{ Trl(ctx, L.Auth.Email) }</th>
									<th class="py-2 pr-3">{ Trl(ctx, L.Auth.FirstName) }</th>
									<th class="py-2 pr-3">{ Trl(ctx, L.Auth.LastName) }</th>
								</tr>
							</thead>
							<tbody>
								for _, r := range data.Recipients {
									<tr class="border-b last:border-0">
										<td class="py-1 pr-3">{ r.Email }</td>
										<td class="py-1 pr-3">{ r.Forename }</td>
										<td class="py-1 pr-3">{ r.Lastname }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			}
		}
	</div>
}
