package listsview

import (
	"app/api/router"
	appdb "app/db"
	. "app/i18n"
	globaltable "github.com/nakami-lounge-GmbH/ui-components/table"
)

const CurrentListsTableID = "lists-table"

func normalizeListsTableRequest(request globaltable.Request) globaltable.Request {
	if request.FilterCriteria == nil {
		request.FilterCriteria = map[string]string{}
	}
	if request.Pagination.Page < 1 {
		request.Pagination.Page = 1
	}
	if request.Pagination.Count <= 0 {
		request.Pagination.Count = 50
	}
	if len(request.Pagination.Sorts) == 0 {
		request.Pagination.Sorts = []globaltable.SortParam{{Field: "name", IsDesc: false}}
	}
	return request
}

func CurrentListsTableProps(lang string, rows []appdb.MailListTableRow, request globaltable.Request, total int64) globaltable.TableProps {
	return globaltable.TableProps{
		Lang:                NormalizeLang(lang),
		ID:                  CurrentListsTableID,
		Class:               "mt-6",
		Endpoint:            router.Reverse(router.Lists.List),
		Request:             normalizeListsTableRequest(request),
		Total:               total,
		Title:               TrLang(lang, L.Lists.AllEmailLists),
		RowClickAccessorKey: "id",
		RowClickURLPattern:  router.Reverse(router.Lists.Detail, "{value}"),
		PageSizes:           []int{10, 25, 50, 100},
		Columns: []globaltable.Column{
			{AccessorKey: "id", Header: TrLang(lang, L.Users.Id), Kind: "id", Width: "5rem", MinWidth: "5rem", Sortable: true},
			{AccessorKey: "name", Header: TrLang(lang, L.Lists.ListName), MinWidth: "14rem", Sortable: true},
			{AccessorKey: "description", Header: TrLang(lang, L.Lists.ListDescription), MinWidth: "20rem"},
			{AccessorKey: "recipientCount", Header: TrLang(lang, L.Lists.NumberOfRecipients), Width: "8rem", MinWidth: "8rem", Sortable: true},
		},
		Data:         rows,
		EmptyMessage: TrLang(lang, L.Lists.NoEmailListsYet),
	}
}

templ CurrentListsTable(lang string, rows []appdb.MailListTableRow, request globaltable.Request, total int64) {
	@globaltable.Table(CurrentListsTableProps(lang, rows, request, total))
}
