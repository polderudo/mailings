package forgotpasswordview

import (
	"app/api/router"
	. "app/i18n"
	uibutton "github.com/templui/templui/components/button"
	uiform "github.com/nakami-lounge-GmbH/ui-components/form"
	uiinput "github.com/nakami-lounge-GmbH/ui-components/input"
)

templ ForgotPasswordFormCard(forgotPasswordError string, forgotPasswordSuccess string, lang string) {
	if forgotPasswordError != "" {
		@uiform.Notice(uiform.NoticeProps{
			Variant: uiform.MessageVariantError,
			Class:   "w-full",
			Title:   "Error",
		}) {
			{ forgotPasswordError }
		}
	}
	if forgotPasswordSuccess != "" {
		@uiform.Notice(uiform.NoticeProps{
			Variant: uiform.MessageVariantInfo,
			Class:   "w-full",
		}) {
			{ forgotPasswordSuccess }
		}
	}
	@uiform.Form(uiform.FormProps{
		Class:  "flex flex-col gap-5 w-full",
		Action: router.Reverse(router.Anon.ForgotPassword),
		Method: "post",
		Attributes: templ.Attributes{
			"hx-swap":    "transition:true",
			"hx-headers": "js:{'X-TimeZone': Intl.DateTimeFormat().resolvedOptions().timeZone}",
		},
	}) {
		@uiform.Item(uiform.ItemProps{Class: "space-y-1.5"}) {
			@uiform.Label(uiform.LabelProps{For: "email"}) {
				{ Trl(ctx, L.Auth.Email) }
			}
			@uiinput.Input(uiinput.Props{
				ID:          "email",
				Name:        "email",
				Type:        uiinput.TypeEmail,
				Required:    true,
				Placeholder: Trl(ctx, L.Auth.Email),
				Attributes: templ.Attributes{
					"pattern": `^[^\s@]+@[^\s@]+\.[^\s@]+$`,
					"title":   Trl(ctx, L.Auth.PleaseEnterAValidEmailAddress),
				},
			})
		}
		<div class="flex justify-end">
			@uibutton.Button(uibutton.Props{Type: uibutton.TypeSubmit}) {
				{ Trl(ctx, L.Auth.SendResetLink) }
			}
		</div>
	}
}
